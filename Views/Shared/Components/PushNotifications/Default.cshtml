@model Okafor_.NET.ViewModels.PushNotificationsViewModel

@* Rendered inside the patient portal, so it speaks the portal's vocabulary:
   a notice rather than a card, and buttons on the shared palette. Every
   data-push-* hook push-notifications.js reads is unchanged. *@
<div data-push-notifications
     data-vapid-public-key="@Model.PublicKey"
     data-save-url="@Model.SaveUrl"
     data-unsubscribe-url="@Model.UnsubscribeUrl"
     data-test-url="@Model.TestUrl">

    <div class="portal-register__cap">
        <h2 class="portal-register__capt">Reminders</h2>
        <p class="portal-register__capn">On this device</p>
    </div>

    <p class="portal-page-lede mb-3">
        Let this device remind you the day before a visit. You can turn it off again at
        any time, and it changes nothing about how the hospital contacts you.
    </p>

    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary" data-push-enable>Turn reminders on</button>
        <button type="button" class="btn btn-outline-secondary" data-push-unsubscribe disabled>Turn them off</button>
        <button type="button" class="btn btn-outline-secondary" data-push-test disabled>Send a test</button>
    </div>

    <div class="portal-notice mb-0 mt-3 alert alert-secondary" data-push-status role="status" aria-live="polite">
        Reminders are off.
    </div>
</div>
