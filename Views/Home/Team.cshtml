@model IEnumerable<Okafor_.NET.Models.Doctor>

@{
    ViewData["Title"] = "Doctors & Team";
    ViewData["PageTitle"] = "Doctors and Care Team in Isuochi | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = "Meet the doctors, management leadership, and patient care staff serving Boniface and Paulina Okafor Memorial Hospital.";
    ViewData["CanonicalPath"] = "/doctors";
    var doctors = Model?.ToList() ?? new List<Okafor_.NET.Models.Doctor>();
    var fatherToochukwu = doctors.FirstOrDefault(doctor =>
        string.Equals(doctor.Slug, "rev-fr-dr-toochukwu-bartholomew-okafor", StringComparison.OrdinalIgnoreCase));
    var medicalOfficerName = "Dr. Opie Thomas N.";
    var medicalOfficerBio = "Dr. Opie Thomas N. is a Nigerian medical officer and general practitioner supporting patients and hospital operations at Boniface & Paulina Okafor Memorial Hospital. His practice includes acute and chronic care, emergency stabilization, maternal and child health, preventive screening, inpatient review, referrals, and community outreach.";
}

<section class="site-page-header">
    <div class="site-page-header__inner">
        <p class="site-page-kicker">Doctors &amp; Team</p>
        <h1 class="site-page-title mt-3">Doctors, leadership, and care staff working together.</h1>
        <p class="site-page-lede mt-4 max-w-3xl">Meet the management, clinical, and care teams serving Boniface &amp; Paulina Okafor Memorial Hospital.</p>
    </div>
</section>

<section class="site-page-surface team-page">
    <div class="mx-auto max-w-site px-6">
        @if (fatherToochukwu is not null)
        {
            <article class="site-card team-feature-profile mb-12 grid overflow-hidden md:grid-cols-[minmax(220px,320px)_1fr]">
                <img src="@fatherToochukwu.ImageUrl"
                     alt="Portrait of @fatherToochukwu.FullName"
                     class="team-feature-profile__media h-80 w-full object-cover object-top md:h-full"
                     width="768"
                     height="1024" />
                <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-primary-800">Founder &amp; Spiritual Care Provider</p>
                    <h2 class="mt-3 text-2xl font-bold leading-tight text-[#1a1a1a] sm:text-3xl">@fatherToochukwu.FullName</h2>
                    <p class="mt-2 text-sm font-semibold text-secondary-950">@fatherToochukwu.Specialty</p>
                    <p class="team-feature-profile__bio mt-4 max-w-3xl text-sm leading-7 text-[#4b4740]">@fatherToochukwu.Bio</p>
                    <div class="site-action-row mt-6">
                        <a asp-controller="Home" asp-action="DoctorProfile" asp-route-slug="@fatherToochukwu.Slug" class="site-button site-button--primary">View full profile</a>
                        @if (fatherToochukwu.Id > 0)
                        {
                            <a asp-controller="Teleconsultations" asp-action="Create" asp-route-departmentId="@fatherToochukwu.DepartmentId" asp-route-doctorId="@fatherToochukwu.Id" class="site-button site-button--secondary">Request teleconsultation</a>
                        }
                        else
                        {
                            <a asp-controller="Teleconsultations" asp-action="Create" class="site-button site-button--secondary">Request teleconsultation</a>
                        }
                    </div>
                </div>
            </article>
        }

        <article class="site-card team-feature-profile mb-12 grid overflow-hidden md:grid-cols-[minmax(220px,320px)_1fr]" aria-labelledby="medical-officer-name">
                <img src="/images/team/dr-opie-thomas.webp"
                     alt="Portrait of @medicalOfficerName"
                     class="team-feature-profile__media h-80 w-full object-cover object-top md:h-full"
                     width="768"
                     height="1047"
                     loading="lazy" />
                <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-primary-800">Medical Officer</p>
                    <h2 id="medical-officer-name" class="mt-3 text-2xl font-bold leading-tight text-[#1a1a1a] sm:text-3xl">@medicalOfficerName</h2>
                    <p class="mt-2 text-sm font-semibold text-secondary-950">Medical Officer &amp; General Practitioner</p>
                    <p class="team-feature-profile__bio mt-4 max-w-3xl text-sm leading-7 text-[#4b4740]">@medicalOfficerBio</p>
                    <div class="site-action-row mt-6">
                        <a asp-controller="Home" asp-action="DoctorProfile" asp-route-slug="dr-opie-thomas-n" class="site-button site-button--primary">View full profile</a>
                        <a asp-controller="AppointmentRequests" asp-action="Create" class="site-button site-button--primary">Request appointment</a>
                    </div>
                </div>
        </article>

    </div>
</section>
