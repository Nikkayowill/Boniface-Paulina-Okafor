@using System.Text.Json

@{
    ViewData["Title"] = "Home";
    ViewData["PageTitle"] = "Hospital in Isuochi, Abia State | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = "Book visits, request teleconsultations, find hospital services, and read plain-language health guidance from Boniface and Paulina Okafor Memorial Hospital in Abia State, Nigeria.";
    ViewData["CanonicalPath"] = "/";

    // The one server-computed payload the React landing page (client/landing)
    // hydrates from. ASP.NET Core stays the system of record for routing; React
    // only renders. See docs/LANDING_PAGE_HANDOFF.md and
    // docs/decisions/0006-react-landing-page-non-headless.md.
    var landingData = new
    {
        urls = new
        {
            appointmentCreate = Url.Action("Create", "AppointmentRequests"),
            teleconsultationCreate = Url.Action("Create", "Teleconsultations"),
            contact = Url.Action("Contact", "Home"),
            services = Url.Action("Services", "Home")
        }
    };

    var landingDataJson = JsonSerializer.Serialize(landingData);
}

@* Server-rendered shell only: React (client/landing, built to wwwroot/js/landing.js)
   owns everything inside #landing-root. Keep this div's class list -- it carries the
   page-level layout hooks (public-site.css) the React tree renders into. See
   docs/LANDING_PAGE_HANDOFF.md for the full contract. *@
<div id="landing-root" class="hospital-home"></div>

@section Scripts {
    <script nonce="@(Context.Items["CspNonce"])" id="landing-data" type="application/json">@Html.Raw(landingDataJson)</script>
    <script nonce="@(Context.Items["CspNonce"])" type="module" src="~/js/landing.js" asp-append-version="true"></script>
}
