@model Okafor_.NET.ViewModels.PublicHomeIndexViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures
@inject Okafor_.NET.Services.ProgramInfoService ProgramInfo

@*
    LANDING PAGE HANDOFF — bare skeleton, no design and no copy.

    Everything visual (Tailwind/site classes, hero carousel, photos) AND the old
    marketing copy (headlines, taglines, body paragraphs) are gone. "Add ..."
    placeholders mark where new copy goes — replace them, don't build around them.

    What's left on purpose, because it's real data/behaviour, not brand copy:
    - hospital name/address/email/emergency numbers/map link (from config)
    - featured department names (from the DB via Model.FeaturedDepartments)
    - the working links to real routes (appointments, teleconsultation, services,
      contact, gallery, the external donate/partner links) and their launch-feature
      flag (bill payments)

    See docs/LANDING_PAGE_HANDOFF.md for where the old copy and design live in git
    history, and how to wire up a React or plain-JS bundle under the site's CSP.
*@

@{
    ViewData["Title"] = "Home";
    ViewData["PageTitle"] = "Hospital in Isuochi, Abia State | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = "Book visits, request teleconsultations, find hospital services, and read plain-language health guidance from Boniface and Paulina Okafor Memorial Hospital in Abia State, Nigeria.";
    ViewData["CanonicalPath"] = "/";

    var hospitalName = Configuration["Hospital:Name"] ?? "Boniface and Paulina Okafor Memorial Hospital";
    var hospitalAddress = Configuration["Hospital:Address"];
    var hospitalEmail = Configuration["Hospital:Email"];
    var emergencyNumbers = Configuration["Hospital:EmergencyNumbers"];
    var mapUrl = Configuration["Hospital:GoogleMapEmbedUrl"];

    var services = Model.FeaturedDepartments?.Take(4).ToList() ?? new List<Okafor_.NET.Models.Department>();
    var careRoutes = new[]
    {
        new { Label = "Appointments", Controller = "AppointmentRequests", Action = "Create", ExternalUrl = (string?)null },
        new { Label = "Virtual care", Controller = "Teleconsultations", Action = "Create", ExternalUrl = (string?)null },
        new { Label = "Bills", Controller = "BillPayments", Action = "Index", ExternalUrl = (string?)null },
        new { Label = "Support", Controller = "Home", Action = "Support", ExternalUrl = (string?)ProgramInfo.DonateUrl }
    };
}

<div id="landing-app">
    <p>@hospitalName</p>

    <h1>Add your headline here</h1>
    <p>Add your supporting line here</p>
    <p>
        <a asp-controller="AppointmentRequests" asp-action="Create">Request appointment</a>
        &middot;
        <a asp-controller="Teleconsultations" asp-action="Create">Ask about teleconsultation</a>
    </p>

    <section aria-label="Care routes">
        <h2>Add a section heading</h2>
        <ul>
            @foreach (var route in careRoutes.Where(route =>
                route.Controller != "BillPayments" ||
                LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.BillPayments)))
            {
                <li>
                    <a href="@(route.ExternalUrl ?? Url.Action(route.Action, route.Controller))"
                       target="@(route.ExternalUrl is not null ? "_blank" : null)"
                       rel="@(route.ExternalUrl is not null ? "noopener noreferrer" : null)">
                        @route.Label
                    </a>
                </li>
            }
        </ul>
    </section>

    <section aria-label="Care philosophy">
        <h2>Add a section heading</h2>
        <p>Add supporting copy here</p>
    </section>

    <section aria-label="Clinical services">
        <h2>Add a section heading</h2>
        <p><a asp-controller="Home" asp-action="Services">View all services</a></p>
        <ul>
            @if (services.Any())
            {
                @foreach (var service in services)
                {
                    <li>@service.Name</li>
                }
            }
            else
            {
                <li>Please contact the hospital team for current department and service details.</li>
            }
        </ul>
    </section>

    <section aria-label="Hospital overview">
        <h2>Add a section heading</h2>
        <p>Add supporting copy here</p>
        <p>
            <a asp-controller="Home" asp-action="Services">Explore hospital services</a>
            &middot;
            <a asp-controller="Home" asp-action="Gallery">View hospital gallery</a>
        </p>
    </section>

    <section aria-label="Hospital support partner">
        <h2>Add a section heading</h2>
        <p>
            <a href="https://www.nigeriafamilyhelperprogram.org/boniface-and-paulina-okafor-hospital" target="_blank" rel="noopener noreferrer">Visit partner website</a>
        </p>
    </section>

    <section aria-label="Visit or contact us">
        <h2>Add a section heading</h2>
        <p>
            <a asp-controller="AppointmentRequests" asp-action="Create">Request appointment</a>
            &middot;
            <a asp-controller="Home" asp-action="Contact">Contact us</a>
        </p>

        <dl>
            <dt>Hospital</dt>
            <dd>@hospitalName</dd>

            <dt>Location</dt>
            <dd>@(!string.IsNullOrWhiteSpace(hospitalAddress) ? hospitalAddress : "Please contact the hospital for current location details.")</dd>

            <dt>Emergency</dt>
            <dd>@(!string.IsNullOrWhiteSpace(emergencyNumbers) ? emergencyNumbers : "Please use the contact page to reach the hospital team.")</dd>

            <dt>Email</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(hospitalEmail))
                {
                    <a href="mailto:@hospitalEmail">@hospitalEmail</a>
                }
                else
                {
                    <span>Please use the contact form for email enquiries.</span>
                }
            </dd>

            <dt>Map</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(mapUrl))
                {
                    <a href="@mapUrl" target="_blank" rel="noopener noreferrer">View map</a>
                }
                else
                {
                    <span>Directions available from the hospital team.</span>
                }
            </dd>
        </dl>
    </section>
</div>

@section Scripts {
    @* Drop your compiled bundle (React or plain JS) here and it will mount over #landing-app. *@
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/landing-app.js" asp-append-version="true" defer></script>
}
