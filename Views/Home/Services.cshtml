@model IEnumerable<Okafor_.NET.Models.Department>
@inject Okafor_.NET.Services.ProgramInfoService ProgramInfo

@{
    ViewData["Title"] = "Our Services";
    ViewData["PageTitle"] = "Hospital Services in Isuochi | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = "Consultations, maternity and antenatal care, surgery, laboratory and ultrasound, eye clinic, immunisation, counselling and outreach clinics at Boniface and Paulina Okafor Memorial Hospital, Isuochi, Abia State.";
    ViewData["CanonicalPath"] = "/services";
    ViewData["SocialImage"] = "/images/placeholders/Hospital/MKEA3316.webp";

    // The service list and photographs come from the hospital's own signage and
    // records. Anchors double as the jump targets for the index above.
    var stories = new[]
    {
        new
        {
            Id = "consultation",
            Eyebrow = "See a doctor",
            Title = "Medical consultation, day or night",
            Image = "/images/placeholders/Hospital/MKEA3316.webp",
            Alt = "A member of the hospital team sitting with a patient at a desk",
            Caption = "Every visit starts the same way: someone listens, then tells you what happens next.",
            Body = "You do not need an appointment to be seen. Come to the hospital and the team will check you, explain what they find, and tell you what it will cost before treatment begins. A doctor lives on site, so there is someone here through the night and at weekends.",
            Points = new[]
            {
                "Open 24 hours, with a doctor in residence",
                "Walk in, or request an appointment ahead of time",
                "Costs explained before treatment starts"
            }
        },
        new
        {
            Id = "antenatal",
            Eyebrow = "Mothers and babies",
            Title = "Antenatal care and safe childbirth",
            Image = "/images/placeholders/Hospital/GQVT1373.webp",
            Alt = "Mothers holding their babies at the hospital",
            Caption = "Mothers and babies at the hospital in Isuochi.",
            Body = "Regular checks through pregnancy let the team follow how you and your baby are doing, treat problems early, and plan for the birth. The hospital has its own maternity ward, so you can deliver here rather than travelling while in labour.",
            Points = new[]
            {
                "Antenatal checks through pregnancy",
                "Delivery in the hospital's maternity ward",
                "Care for you and your baby after the birth"
            }
        },
        new
        {
            Id = "children",
            Eyebrow = "Children",
            Title = "Care for babies and children",
            Image = "/images/placeholders/Hospital/NMYG7836.webp",
            Alt = "A nurse preparing medicines and vaccines at a clinic table",
            Caption = "Routine immunisation protects children against illnesses that are far harder to treat later.",
            Body = "Bring your child for immunisation, for the ordinary fevers and stomach upsets that worry every parent, and for anything that is not getting better. Malaria, chest infections and diarrhoea are treatable when they are caught early, and dangerous when they are not.",
            Points = new[]
            {
                "Routine childhood immunisation",
                "Treatment for malaria, chest and stomach infections",
                "Advice on feeding, growth and recovery at home"
            }
        },
        new
        {
            Id = "surgery",
            Eyebrow = "Surgery and admission",
            Title = "Surgery and staying overnight",
            Image = "/images/placeholders/Hospital/UDVH5500.webp",
            Alt = "Beds made up and ready on a hospital ward",
            Caption = $"The hospital has {ProgramInfo.HospitalBeds} beds, including a maternity ward.",
            Body = $"The hospital carries out surgery and can admit you for as long as your recovery takes. There are {ProgramInfo.HospitalBeds} beds across the wards. Solar panels and batteries keep the power on around the clock, and the hospital's own treated-water plant supplies the wards.",
            Points = new[]
            {
                "Operating theatre and surgical care",
                $"{ProgramInfo.HospitalBeds} beds, including a maternity ward",
                "Power and clean running water 24 hours a day"
            }
        },
        new
        {
            Id = "diagnostics",
            Eyebrow = "Tests and scans",
            Title = "Laboratory, diagnostics and ultrasound",
            Image = "/images/placeholders/Hospital/TDUB1133.webp",
            Alt = "The entrance to the hospital laboratory",
            Caption = "Samples are tested here, so results come back the same visit wherever possible.",
            Body = "Guesswork makes treatment more expensive, not less. The laboratory and diagnostic centre runs the tests that confirm what is actually wrong, and ultrasound is available for pregnancy and for investigating pain or swelling.",
            Points = new[]
            {
                "Laboratory and diagnostic centre on site",
                "Ultrasound scanning",
                "Tests for malaria, blood pressure, diabetes and infection"
            }
        },
        new
        {
            Id = "eye-clinic",
            Eyebrow = "Eye clinic",
            Title = "Sight testing and eye care",
            Image = "/images/placeholders/Hospital/GOEH7326.webp",
            Alt = "Boniface and Paulina Okafor Memorial Hospital sign at the facility entrance",
            Caption = "Failing sight is one of the most common and most treatable problems the clinic sees.",
            Body = "Losing your sight costs you your work and your independence, and a great deal of it is preventable. The eye clinic checks vision, treats infections and irritation, and identifies the people who need to be referred on for surgery.",
            Points = new[]
            {
                "Vision checks for adults and children",
                "Treatment for eye infections and irritation",
                "Referral onward where surgery is needed"
            }
        },
        new
        {
            Id = "medicines",
            Eyebrow = "Medicines",
            Title = "Medicines dispensed on site",
            Image = "/images/placeholders/Hospital/UDVH5500.webp",
            Alt = "Beds made up and ready on a hospital ward",
            Caption = "Prescriptions are filled here, so treatment can begin before you leave.",
            Body = "There is no point in a prescription you cannot fill. Medicines are stocked and dispensed at the hospital, and the team will explain how to take them, for how long, and what to do if you feel worse instead of better.",
            Points = new[]
            {
                "Prescriptions filled during your visit",
                "Clear instructions on how and when to take them",
                "Support for long-term conditions such as blood pressure and diabetes"
            }
        },
        new
        {
            Id = "counselling",
            Eyebrow = "Counselling and health education",
            Title = "Support for the things that are harder to say",
            Image = "/images/placeholders/Hospital/UDIU2949.webp",
            Alt = "Hospital staff visiting and sitting with older members of the community",
            Caption = "Some patients cannot travel. Doctors and nurses go to them.",
            Body = "Confidential counselling is available for emotional, family and personal difficulties. The team also runs health education so families know how to prevent malaria, recognise high blood pressure and diabetes, and understand what treatment involves before they need it.",
            Points = new[]
            {
                "Confidential counselling for individuals and families",
                "Health education on malaria, blood pressure, diabetes and HIV",
                "Home visits by doctors and nurses for patients who cannot travel"
            }
        },
        new
        {
            Id = "outreach",
            Eyebrow = "In the community",
            Title = "Outreach clinics closer to home",
            Image = "/images/placeholders/Hospital/WVHK5210.webp",
            Alt = "Community members waiting to be seen at a medical outreach clinic",
            Caption = $"{ProgramInfo.HeadlineImpact[1].Value} people have been seen at outreach clinics.",
            Body = "For many families the journey to a hospital is the reason care never happens. The hospital and the Nigeria Family Helper Program run outreach clinics that bring checks, treatment and health advice into the surrounding communities.",
            Points = new[]
            {
                "Periodic clinics held in surrounding communities",
                "Checks, treatment and health advice at no cost to attend",
                "Referral to the hospital for anyone who needs more care"
            }
        },
        new
        {
            Id = "training",
            Eyebrow = "Training",
            Title = "Training the Health Care Assistants this region needs",
            Image = "/images/placeholders/Hospital/JUVE0797.webp",
            Alt = "Members of the hospital nursing team",
            Caption = $"{ProgramInfo.NursingTrainees} students are currently training as health care assistants.",
            Body = $"The shortage here is people, not just equipment. The hospital runs Health Care Assistant training, and {ProgramInfo.NursingTrainees} students are in training as Health Care Assistants. Every one of them is a person who stays in this community and keeps caring for it.",
            Points = new[]
            {
                "Health Care Assistant training at the hospital",
                $"{ProgramInfo.NursingTrainees} Health Care Assistants currently in training",
                "Skills that stay in the community"
            }
        }
    };

    // A contextual next step, only where one genuinely differs. Repeating the same
    // button under all ten sections reads as noise rather than help; the header and
    // the closing band already carry the primary call to action.
    var storyActions = new Dictionary<string, (string Text, string Controller, string Action, string? Feature)>
    {
        ["consultation"] = ("Request an appointment", "AppointmentRequests", "Create", "appointment"),
        ["antenatal"] = ("Request an antenatal appointment", "AppointmentRequests", "Create", "appointment"),
        ["counselling"] = ("Request a private teleconsultation", "Teleconsultations", "Create", "teleconsultation"),
        ["outreach"] = ("Ask when the next outreach clinic is", "Home", "Contact", null),
        ["training"] = ("Ask about Health Care Assistant training", "Home", "Contact", null)
    };

    // Photographs whose subject sits away from the middle of the frame and would
    // otherwise be cropped out by the 4:3 panel.
    var storyFocus = new Dictionary<string, string>
    {
        ["diagnostics"] = "center 18%"
    };
}

<div class="services-page">

    <section class="site-page-header">
        <div class="site-page-header__inner">
            <p class="site-page-kicker">Our Services</p>
            <h1 class="site-page-title mt-3 max-w-4xl">Care you can reach, in the place where you live.</h1>
            <p class="site-page-lede mt-5 max-w-2xl">
                Boniface and Paulina Okafor Memorial Hospital provides quality, subsidised healthcare to families
                in and around Isuochi. Below is everything the hospital offers, and what to expect when you come.
            </p>
            <div class="site-action-row mt-7">
                <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create"
                   data-live-feature="appointment"
                   class="site-button site-button--primary">Request an appointment</a>
                <a asp-area="" asp-controller="Home" asp-action="Contact"
                   class="site-button site-button--secondary">Contact the hospital</a>
            </div>
        </div>
    </section>

    <!-- Jump list: for visitors who already know what they need. -->
    <section class="border-b border-bone-200 bg-white">
        <div class="mx-auto max-w-site px-6 py-10 md:py-14">
            <p class="site-page-kicker">Everything we offer</p>
            <h2 class="mt-3 font-serif text-2xl font-semibold text-[#1a1a1a] sm:text-3xl">Go straight to what you need.</h2>
            <nav class="service-index" aria-label="Hospital services">
                @{ var indexNumber = 0; }
                @foreach (var story in stories)
                {
                    indexNumber++;
                    <a href="#@story.Id">
                        <span class="service-index__num">@indexNumber.ToString("00")</span>
                        <span>@story.Title</span>
                    </a>
                }
            </nav>
        </div>
    </section>

    <!-- The main sequence: photograph beside its description, mirrored row by row. -->
    <section class="bg-white">
        <div class="mx-auto max-w-site px-6">
            <div class="service-stories">
                @foreach (var story in stories)
                {
                    <article class="service-story" id="@story.Id">
                        <figure class="service-story__media">
                            <img src="@story.Image"
                                 alt="@story.Alt"
                                 loading="lazy"
                                 decoding="async"
                                 style="@(storyFocus.TryGetValue(story.Id, out var focus) ? $"object-position:{focus}" : null)">
                            <figcaption>@story.Caption</figcaption>
                        </figure>
                        <div class="service-story__copy">
                            <p class="service-story__eyebrow">@story.Eyebrow</p>
                            <h2>@story.Title</h2>
                            <p>@story.Body</p>
                            <ul class="service-story__points">
                                @foreach (var point in story.Points)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                            @if (storyActions.TryGetValue(story.Id, out var action))
                            {
                                <div class="service-story__actions">
                                    <a asp-area="" asp-controller="@action.Controller" asp-action="@action.Action"
                                       data-live-feature="@action.Feature"
                                       class="site-button site-button--secondary">@action.Text</a>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- Impact figures published by the funding charity, dated so they age honestly. -->
    <section class="impact-band">
        <div class="mx-auto max-w-site px-6">
            <div class="impact-band__head">
                <p class="hospital-kicker">Why this matters</p>
                <h2>What this hospital does in a year.</h2>
                <p>
                    The hospital exists because the @ProgramInfo.Name built it. These are the figures the
                    program reports as of @ProgramInfo.ImpactAsOf.
                </p>
            </div>
            <div class="impact-grid">
                @foreach (var figure in ProgramInfo.HeadlineImpact)
                {
                    <div>
                        <strong>@figure.Value</strong>
                        <span>@figure.Label</span>
                        <em>@figure.Detail</em>
                    </div>
                }
            </div>
            <p class="impact-band__source">
                Figures reported by the @ProgramInfo.Name (Charity Registration @ProgramInfo.CharityRegistration)
                as of @ProgramInfo.ImpactAsOf.
                <a href="@ProgramInfo.Website" target="_blank" rel="noopener noreferrer">Visit the program website</a>.
            </p>
        </div>
    </section>

    @if (Model.Any())
    {
        <section class="site-page-surface">
            <div class="mx-auto max-w-site px-6">
                <div class="max-w-2xl">
                    <p class="site-page-kicker">Clinical departments</p>
                    <h2 class="mt-3 font-serif text-3xl font-semibold text-[#1a1a1a]">Departments and the teams behind them.</h2>
                    <p class="mt-4 text-base leading-8 text-[#4b4740]">
                        Services are delivered by these departments. If you are not sure which one you need,
                        ask at reception and someone will point you to the right place.
                    </p>
                </div>
                <div class="mt-8 grid items-stretch gap-5 md:grid-cols-2 lg:grid-cols-3">
                    @foreach (var service in Model)
                    {
                        <article id="service-@service.Id" class="site-card flex h-full flex-col p-6">
                            <h3 class="font-serif text-xl font-semibold text-[#1a1a1a]">@service.Name</h3>
                            <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-[#4b4740]">
                                @(!string.IsNullOrWhiteSpace(service.Description)
                                    ? service.Description
                                    : "Care delivered by the hospital's clinical team.")
                            </p>
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Closing actions: get care, or help pay for someone else's. -->
    <section class="border-t border-bone-200 bg-white">
        <div class="mx-auto grid max-w-site gap-10 px-6 py-14 lg:grid-cols-2 lg:py-20">
            <div>
                <p class="site-page-kicker">If you need care</p>
                <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-[#1a1a1a]">Come in, or ask us to call you back.</h2>
                <p class="mt-4 max-w-xl text-base leading-8 text-[#4b4740]">
                    You can walk in at any hour. If you would rather arrange a time first, send a request
                    and the team will confirm what is available.
                </p>
                <div class="site-action-row mt-6">
                    <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create"
                       data-live-feature="appointment"
                       class="site-button site-button--primary">Request an appointment</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contact"
                       class="site-button site-button--secondary">Contact us</a>
                </div>
            </div>
            <div>
                <p class="site-page-kicker">If you want to help</p>
                <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-[#1a1a1a]">Keep this care available all year.</h2>
                <p class="mt-4 max-w-xl text-base leading-8 text-[#4b4740]">
                    Care here is subsidised for families who could not otherwise pay for it. Regular monthly
                    giving is what keeps the wards staffed and stocked between campaigns.
                </p>
                <div class="site-action-row mt-6">
                    <a href="@ProgramInfo.DonateUrl" target="_blank" rel="noopener noreferrer"
                       class="site-button site-button--primary">Give monthly</a>
                </div>
            </div>
        </div>
    </section>

</div>
