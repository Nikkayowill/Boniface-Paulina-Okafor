@model Okafor_.NET.Models.Doctor
@inject Okafor_.NET.Services.ProgramInfoService ProgramInfo

@{
    ViewData["Title"] = Model.FullName;
    ViewData["PageTitle"] = $"{Model.FullName}, {Model.Specialty} | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = $"Read about {Model.FullName}, {Model.Specialty}, and the care team at Boniface and Paulina Okafor Memorial Hospital in Isuochi.";
    ViewData["CanonicalPath"] = $"/doctors/{Model.Slug}";
    var initials = string.Concat(
        Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                      .Take(2)
                      .Select(name => char.ToUpperInvariant(name[0])));
    var isFatherToochukwu = string.Equals(
        Model.Slug,
        "rev-fr-dr-toochukwu-bartholomew-okafor",
        StringComparison.OrdinalIgnoreCase);
    var isMedicalOfficer = string.Equals(
        Model.Slug,
        "dr-opie-thomas-n",
        StringComparison.OrdinalIgnoreCase);
}

<section class="site-page-header">
    <div class="site-page-header__inner max-w-6xl">
        <p class="site-page-kicker">@(isFatherToochukwu ? "Founder & Care Provider" : "Doctor Profile")</p>
        <h1 class="site-page-title mt-3">@Model.FullName</h1>
        <p class="site-page-lede mt-3">@Model.Specialty</p>
    </div>
</section>

<section class="site-page-surface">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 md:grid-cols-[300px_1fr]">
        <aside>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     onerror="this.onerror=null;this.hidden=true;"
                     alt="Photo of @Model.FullName"
                     class="h-80 w-full rounded-md border border-bone-200 object-cover object-top" />
            }
            else
            {
                <div class="flex h-80 items-center justify-center rounded-md border border-bone-200 bg-primary-50" aria-hidden="true">
                    <span class="font-serif text-5xl font-bold text-primary-700">@initials</span>
                </div>
            }

            @if (isFatherToochukwu)
            {
                @if (Model.Id > 0)
                {
                    <a asp-controller="Teleconsultations"
                       asp-action="Create"
                       asp-route-departmentId="@Model.DepartmentId"
                       asp-route-doctorId="@Model.Id"
                       class="site-button site-button--primary mt-4 w-full">
                        Request Psychotherapy Teleconsultation
                    </a>
                }
                else
                {
                    <a asp-controller="Teleconsultations"
                       asp-action="Create"
                       class="site-button site-button--primary mt-4 w-full">
                        Request Psychotherapy Teleconsultation
                    </a>
                }
                <p class="mt-3 text-xs leading-5 text-[#5a544a]">Requests are reviewed before a private video session is confirmed. Staff will explain the session fee or any sponsored-care availability before confirmation. This service is not for emergencies.</p>
                <a href="@ProgramInfo.DonateUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="site-button site-button--secondary mt-3 w-full">
                    Support the hospital's care programs
                </a>
                <p class="mt-2 text-xs leading-5 text-[#5a544a]">Donations are optional hospital program support. They are separate from session fees and do not affect booking priority.</p>
            }
            else
            {
                <a asp-controller="AppointmentRequests"
                   asp-action="Create"
                   asp-route-departmentId="@Model.DepartmentId"
                   asp-route-doctorId="@Model.Id"
                   class="site-button site-button--primary mt-4 w-full">
                    Book Appointment
                </a>
            }
        </aside>

        <article class="site-card p-6">
            <dl class="space-y-4 text-sm text-[#3d3930]">
                <div>
                    <dt class="font-semibold text-[#1a1a1a]">Specialty</dt>
                    <dd class="mt-1">@Model.Specialty</dd>
                </div>
                <div>
                    <dt class="font-semibold text-[#1a1a1a]">Department</dt>
                    <dd class="mt-1">@(Model.Department?.Name ?? "N/A")</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Qualifications) && !isFatherToochukwu)
                {
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Qualifications</dt>
                        <dd class="mt-1">@Model.Qualifications</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ConsultationHours))
                {
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">@(isFatherToochukwu ? "Teleconsultation Availability" : "Consultation Hours")</dt>
                        <dd class="mt-1">@Model.ConsultationHours</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Profile</dt>
                        <dd class="mt-1 leading-7">@Model.Bio</dd>
                    </div>
                }
                else
                {
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Profile</dt>
                        <dd class="mt-1 leading-7">Professional profile information will be updated soon.</dd>
                    </div>
                }
                @if (isFatherToochukwu)
                {
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Education and Training</dt>
                        <dd class="mt-2">
                            <ul class="list-disc space-y-2 pl-5 leading-6 marker:text-primary-700">
                                <li>Bachelor of Philosophy (B.Phil), Claretian Institute of Philosophy, Nekede, Owerri — affiliated with the Pontifical Urban University, Rome</li>
                                <li>Bachelor of Theology (B.Th), Bigard Memorial Seminary, Enugu — affiliated with the Pontifical Urban University, Rome</li>
                                <li>Diploma in Drug Dependency Counselling, St. Bonaventure University in association with Hogares Claret, Medellín, Colombia</li>
                                <li>Master of Arts in Counselling Psychology, Yorkville University, New Brunswick, Canada</li>
                                <li>Doctor of Philosophy in Clinical Psychology, Enugu State University of Science and Technology, Enugu, Nigeria</li>
                            </ul>
                        </dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Languages</dt>
                        <dd class="mt-1">Igbo, English, Spanish, and basic French</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Leadership</dt>
                        <dd class="mt-1 leading-7">Founder of B&amp;P Memorial Hospital and B&amp;P Charity Foundation; Coordinator of Projects for the Nigeria Family Helper Program in Halifax, Canada.</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-[#1a1a1a]">Contact</dt>
                        <dd class="mt-1"><a href="mailto:toochukwuokafor@yahoo.com" class="font-semibold text-primary-800 underline decoration-primary-300 underline-offset-4">toochukwuokafor@yahoo.com</a></dd>
                    </div>
                }
            </dl>

            @if (isMedicalOfficer)
            {
                <section class="mt-10 border-t border-bone-200 pt-8" aria-labelledby="clinical-scope-title">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-primary-800">Patient care &amp; hospital operations</p>
                    <h2 id="clinical-scope-title" class="mt-2 font-serif text-3xl text-[#1a1a1a]">Clinical scope &amp; responsibilities</h2>
                    <p class="mt-3 text-sm leading-7 text-[#5a544a]">Comprehensive general practice focused on continuity, prevention, and timely clinical coordination.</p>
                    <div class="mt-7 grid gap-4 sm:grid-cols-2">
                        <div class="border-t border-bone-200 pt-4">
                            <p class="font-semibold text-[#1a1a1a]">Clinical care &amp; emergency</p>
                            <p class="mt-2 text-sm leading-6 text-[#5a544a]">Diagnosis and treatment of acute and chronic illnesses, medical emergency stabilization, minor surgical procedures, and inpatient reviews.</p>
                        </div>
                        <div class="border-t border-bone-200 pt-4">
                            <p class="font-semibold text-[#1a1a1a]">Maternal &amp; child health</p>
                            <p class="mt-2 text-sm leading-6 text-[#5a544a]">Antenatal and postnatal care management, uncomplicated deliveries, routine pediatric and newborn care, and high-risk case triage.</p>
                        </div>
                        <div class="border-t border-bone-200 pt-4">
                            <p class="font-semibold text-[#1a1a1a]">Preventive public health</p>
                            <p class="mt-2 text-sm leading-6 text-[#5a544a]">Disease prevention education, immunization programs, screenings for hypertension, diabetes, HIV, and TB, and lifestyle counseling.</p>
                        </div>
                        <div class="border-t border-bone-200 pt-4">
                            <p class="font-semibold text-[#1a1a1a]">Leadership &amp; coordination</p>
                            <p class="mt-2 text-sm leading-6 text-[#5a544a]">Supervision of nurses and interns, medical record compliance, referral coordination, and community health outreach.</p>
                        </div>
                    </div>
                </section>
            }
        </article>
    </div>
</section>
