@model Okafor_.NET.ViewModels.TeleconsultationRequestViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Book a Teleconsultation";
    ViewData["PageTitle"] = "Request a Teleconsultation | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = "Request a video or follow-up consultation with Okafor Memorial Hospital. A clinician will review whether virtual care is appropriate before confirmation.";
    ViewData["CanonicalPath"] = "/Teleconsultations/Create";
    var hasDepartments = ViewBag.HasDepartments as bool? ?? false;
    var isFatherToochukwu = ViewBag.IsFatherToochukwu as bool? ?? false;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var doctorsJson = JsonSerializer.Serialize(
        ViewBag.TeleconsultationDoctors ?? Array.Empty<object>());
}

<section class="site-page-header">
    <div class="site-page-header__inner">
        <p class="site-page-kicker">Virtual care</p>
        <h1 class="site-page-title mt-4">Book a Teleconsultation</h1>
        <p class="site-page-lede mt-4">
            Tell us which team you need, when suits you, and how to reach you. A doctor will call you to confirm
            and take any medical details over the phone.
        </p>
    </div>
</section>

<section class="page-section">
    <div class="bp-wrap booking-layout">
        <div class="booking-panel">
            @if (!hasDepartments)
            {
                <h2 class="page-subheading">Teleconsultations are temporarily unavailable</h2>
                <p class="page-body mt-4">No clinical teams are taking online requests right now. Please contact the hospital directly.</p>
                <div class="site-action-row mt-8">
                    <a asp-controller="Home" asp-action="Contact" class="site-button site-button--primary">Contact Us</a>
                </div>
            }
            else
            {
                <script nonce="@(Context.Items["CspNonce"])" id="teleconsultation-doctors-data" type="application/json">@Html.Raw(doctorsJson)</script>

                <form asp-action="Create"
                      method="post"
                      class="requires-network booking-form"
                      data-teleconsultation-form>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="ok-alert" role="alert" aria-live="assertive"></div>

                    <fieldset class="booking-step">
                        <legend class="booking-step__title"><span class="booking-step__number" aria-hidden="true">1</span>When would you like to talk?</legend>

                        <div>
                            <label asp-for="DepartmentId" class="ok-form-label">Department / Specialty</label>
                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.DepartmentId"
                                    class="ok-field"
                                    data-teleconsultation-department
                                    required>
                                <option value="">Select a department</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="DoctorId" class="ok-form-label">Preferred Doctor <span class="ok-optional">(optional)</span></label>
                            <select asp-for="DoctorId"
                                    asp-items="ViewBag.DoctorId"
                                    class="ok-field"
                                    aria-describedby="teleconsultation-doctor-help"
                                    data-teleconsultation-doctor>
                                <option value="">No preference</option>
                            </select>
                            <p id="teleconsultation-doctor-help" class="ok-help" data-teleconsultation-doctor-help>
                                Choose a department first. You can leave the doctor as “No preference”.
                            </p>
                            <span asp-validation-for="DoctorId" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div class="ok-note ok-note-accent"
                             data-father-toochukwu-fee-note
                             hidden="@(!isFatherToochukwu ? "hidden" : null)">
                            <p class="font-semibold text-[#1a1a1a]">Psychotherapy session costs</p>
                            <p class="mt-1 text-sm leading-6">This service is not advertised as free. Staff will explain Father Toochukwu's session fee or any sponsored-care availability before confirming your private video appointment.</p>
                        </div>

                        <div class="booking-form__pair">
                            <div>
                                <label asp-for="PreferredDate" class="ok-form-label">Preferred Date</label>
                                <input asp-for="PreferredDate" type="date" min="@today" class="ok-field" required />
                                <span asp-validation-for="PreferredDate" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                            <div>
                                <label asp-for="PreferredTime" class="ok-form-label">Preferred Time</label>
                                <select asp-for="PreferredTime" class="ok-field" required>
                                    <option value="">Select a time</option>
                                    <option>08:00 AM</option>
                                    <option>09:00 AM</option>
                                    <option>10:00 AM</option>
                                    <option>11:00 AM</option>
                                    <option>01:00 PM</option>
                                    <option>02:00 PM</option>
                                    <option>03:00 PM</option>
                                </select>
                                <span asp-validation-for="PreferredTime" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="booking-step">
                        <legend class="booking-step__title"><span class="booking-step__number" aria-hidden="true">2</span>How can we reach you?</legend>

                        <div>
                            <label asp-for="PatientName" class="ok-form-label">Full Name</label>
                            <input asp-for="PatientName" class="ok-field" maxlength="150" autocomplete="name" required />
                            <span asp-validation-for="PatientName" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Phone" class="ok-form-label">Phone Number</label>
                            <div class="booking-form__phone">
                                <select asp-for="PhoneCountryCode"
                                        autocomplete="tel-country-code"
                                        aria-label="Phone country code"
                                        class="ok-field"
                                        required>
                                    <option value="+234">+234 NG</option>
                                    <option value="+233">+233 GH</option>
                                    <option value="+44">+44 UK</option>
                                    <option value="+1">+1 US/CA</option>
                                </select>
                                <input asp-for="Phone"
                                       type="tel"
                                       maxlength="30"
                                       inputmode="tel"
                                       autocomplete="tel-national"
                                       placeholder="8012345678"
                                       class="ok-field"
                                       aria-describedby="teleconsultation-phone-help"
                                       required />
                            </div>
                            <p id="teleconsultation-phone-help" class="ok-help">The doctor will call or text this number.</p>
                            <span asp-validation-for="PhoneCountryCode" class="mt-1 block text-sm text-red-600"></span>
                            <span asp-validation-for="Phone" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="ok-form-label">Email <span class="ok-optional">(optional)</span></label>
                            <input asp-for="Email" class="ok-field" maxlength="150" inputmode="email" autocomplete="email" aria-describedby="teleconsultation-email-help" />
                            <p id="teleconsultation-email-help" class="ok-help">Only if you would like confirmations by email too.</p>
                            <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                    </fieldset>

                    <div class="booking-form__submit">
                        <button type="submit" class="site-button site-button--primary" data-teleconsultation-submit>
                            <span data-teleconsultation-submit-label>Send Request</span>
                            <svg data-teleconsultation-submit-spinner hidden class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                            </svg>
                        </button>
                        <p class="ok-help">By sending this request you agree to be contacted about virtual care. In an emergency call <strong>+234 904 292 9406</strong>.</p>
                    </div>
                </form>
            }
        </div>

        <aside class="booking-aside" aria-labelledby="teleconsultation-next-title">
            <h2 id="teleconsultation-next-title" class="page-subheading">What happens next</h2>
            <ol class="booking-aside__steps">
                <li>We review your request.</li>
                <li>A doctor calls or texts you to confirm the time and ask about your health.</li>
                <li>You receive the video link before your appointment.</li>
            </ol>
            <p class="booking-aside__urgent">Emergency? Do not wait. Call <strong>+234 904 292 9406</strong>.</p>
        </aside>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    @if (hasDepartments)
    {
        <script nonce="@(Context.Items["CspNonce"])" src="~/js/teleconsultation-form.js" asp-append-version="true"></script>
    }
}
