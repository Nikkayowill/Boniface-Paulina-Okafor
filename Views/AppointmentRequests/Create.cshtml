@model Okafor_.NET.Models.AppointmentRequest

@{
    ViewData["Title"] = "Book Appointment";
    ViewData["PageTitle"] = "Request a Hospital Appointment in Isuochi | Okafor Memorial Hospital";
    ViewData["MetaDescription"] = "Send an appointment request to Boniface and Paulina Okafor Memorial Hospital in Isuochi. Hospital staff will review the request and confirm availability.";
    ViewData["CanonicalPath"] = "/AppointmentRequests/Create";
    var hasDoctors = ViewBag.HasDoctors as bool? ?? false;
}

<section class="site-page-header">
    <div class="site-page-header__inner">
        <p class="site-page-kicker">Visit the hospital</p>
        <h1 class="site-page-title mt-4">Book an Appointment</h1>
        <p class="site-page-lede mt-4">
            Choose a doctor and a free time, then tell us how to reach you. We only need your name and phone number;
            staff will ask about your health when they call.
        </p>
    </div>
</section>

<section class="page-section">
    <div class="bp-wrap booking-layout">
        <div class="booking-panel booking-panel--widget">
            @if (!hasDoctors)
            {
                <h2 class="page-subheading">Online booking is temporarily unavailable</h2>
                <p class="page-body mt-4">No doctors are taking online bookings right now. Please contact the hospital directly.</p>
                <div class="site-action-row mt-8">
                    <a asp-area="" asp-controller="Home" asp-action="Contact" class="site-button site-button--primary">Contact Us</a>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_BookingWidget")
                <noscript>
                    <form asp-action="Create" method="post" class="booking-form">
                        <div asp-validation-summary="ModelOnly" class="ok-alert" role="alert"></div>

                        <fieldset class="booking-step">
                            <legend class="booking-step__title"><span class="booking-step__number" aria-hidden="true">1</span>Doctor and time</legend>
                            <div>
                                <label asp-for="DepartmentId" class="ok-form-label">Department</label>
                                <select asp-for="DepartmentId" asp-items="ViewBag.DepartmentId" class="ok-field">
                                    <option value="">Select a department...</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                            <div>
                                <label asp-for="DoctorId" class="ok-form-label">Doctor</label>
                                <select asp-for="DoctorId" asp-items="ViewBag.FallbackDoctorId" class="ok-field">
                                    <option value="">Select a doctor...</option>
                                </select>
                                <span asp-validation-for="DoctorId" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                            <div class="booking-form__pair">
                                <div>
                                    <label asp-for="PreferredDate" class="ok-form-label">Preferred date</label>
                                    <input asp-for="PreferredDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(60).ToString("yyyy-MM-dd")" class="ok-field">
                                    <span asp-validation-for="PreferredDate" class="mt-1 block text-sm text-red-600"></span>
                                </div>
                                <div>
                                    <label asp-for="PreferredTime" class="ok-form-label">Preferred time</label>
                                    <input asp-for="PreferredTime" type="time" step="1800" class="ok-field">
                                    <span asp-validation-for="PreferredTime" class="mt-1 block text-sm text-red-600"></span>
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="booking-step">
                            <legend class="booking-step__title"><span class="booking-step__number" aria-hidden="true">2</span>How can we reach you?</legend>
                            <div>
                                <label asp-for="PatientName" class="ok-form-label">Full name</label>
                                <input asp-for="PatientName" autocomplete="name" class="ok-field">
                                <span asp-validation-for="PatientName" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                            <div>
                                <label asp-for="Phone" class="ok-form-label">Phone</label>
                                <input asp-for="Phone" type="tel" autocomplete="tel" class="ok-field">
                                <span asp-validation-for="Phone" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                            <div>
                                <label asp-for="Email" class="ok-form-label">Email <span class="ok-optional">(optional)</span></label>
                                <input asp-for="Email" type="email" autocomplete="email" class="ok-field">
                                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                        </fieldset>

                        <div class="booking-form__submit">
                            <button type="submit" class="site-button site-button--primary">Send Request</button>
                        </div>
                    </form>
                </noscript>
            }
        </div>

        <aside class="booking-aside" aria-labelledby="appointment-next-title">
            <h2 id="appointment-next-title" class="page-subheading">What happens next</h2>
            <ol class="booking-aside__steps">
                <li>The times you see are live, so the one you pick is held for you.</li>
                <li>Staff call or text you to confirm and ask about your health.</li>
                <li>You get a reminder the day before your visit.</li>
            </ol>
            <p class="booking-aside__urgent">Emergency? Do not wait. Call <strong>112</strong> or <strong>199</strong>.</p>
        </aside>
    </div>
</section>

@section Scripts {
    @* The widget asks okaforBookingRealtime for live slot updates, so the pair has
       to load here now that the layout no longer ships them site-wide. *@
    <script nonce="@(Context.Items["CspNonce"])" src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/booking-realtime.js" asp-append-version="true"></script>
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/booking-widget.js" asp-append-version="true"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
