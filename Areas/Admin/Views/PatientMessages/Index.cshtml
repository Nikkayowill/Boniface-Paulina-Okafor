@model Okafor_.NET.ViewModels.PagedResult<Okafor_.NET.ViewModels.PatientMessageListItemViewModel>

@{
    ViewData["Title"] = "Patient messages";

    var pending = (int)(ViewData["PendingCount"] ?? 0);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Patient records</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Patient messages</h1>
    </div>
    <p class="portal-page-lede">
        Written by patients from inside their own portal, so each one is already
        attached to a file.
    </p>
</div>

@if (Model.TotalCount == 0)
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">No messages have been sent</p>
        <p class="portal-empty__p">
            When a patient writes to the hospital from their portal, the message
            arrives here with their name and contact details beside it.
        </p>
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of messages</h2>
            <p class="portal-register__capn">
                @pending awaiting review &middot;
                @Model.TotalCount @(Model.TotalCount == 1 ? "message" : "messages") in all
            </p>
        </div>

        @foreach (var message in Model.Items)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@message.SentAt.ToLocalTime().ToString("dd")</span>
                    <span class="portal-register__m">@message.SentAt.ToLocalTime().ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@message.Subject</p>
                    <p class="portal-register__meta">
                        @Or(message.PatientName, "Unknown patient") &middot;
                        @message.SentAt.ToLocalTime().ToString("h:mm tt")
                    </p>
                    <p class="portal-register__sub">@Or(message.PatientEmail, "No email on the account")</p>
                </div>

                <p class="mb-0">
                    <span class="portal-mark @(message.IsRead ? "bg-success" : "bg-warning")">
                        @(message.IsRead ? "Reviewed" : "Awaiting review")
                    </span>
                </p>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@message.Id" class="portal-act">Read it</a>
                </div>
            </div>
        }
    </div>

    <partial name="_Pager" model="@(new Okafor_.NET.ViewModels.PagerViewModel { Page = Model.Page, TotalPages = Model.TotalPages })" />
}
