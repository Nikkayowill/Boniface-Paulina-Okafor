@model Okafor_.NET.ViewModels.AdminDashboardViewModel
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures

@{
    ViewData["Title"] = "Overview";

    var billPaymentsEnabled = LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.BillPayments);

    // One shape for every queue. Each row is the count and the door to it, so
    // the same list that says how much is outstanding is the way in to clear it.
    var queues = new List<(string Label, int Count, string Controller, string Note)>
    {
        ("Appointment requests", Model.PendingAppointmentsCount, "AppointmentRequests", "awaiting a decision"),
        ("Teleconsultations", Model.PendingTeleconsultationsCount, "Teleconsultations", "awaiting a decision"),
        ("Patient messages", Model.UnreadPatientMessagesCount, "PatientMessages", "awaiting review")
    };

    if (billPaymentsEnabled)
    {
        queues.Add(("Bill payments", Model.PendingBillPaymentsCount, "BillPayments", "unconfirmed"));
    }

    var openItems = queues.Sum(queue => queue.Count);

    var waiting = Model.LongestWaiting;

    // Whole days, counted from the moment the request arrived. "3 days" is the
    // figure a member of staff repeats to a patient on the telephone.
    var daysWaiting = waiting is null ? 0 : (int)Math.Floor((DateTime.UtcNow - waiting.WaitingSince).TotalDays);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The hospital office</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Overview</h1>
        <a asp-area="Admin" asp-controller="PatientAppointments" asp-action="Create" class="btn btn-primary">Book an appointment</a>
    </div>
</div>

<div class="alert d-none" data-booking-realtime role="status" aria-live="polite"></div>

@if (waiting is not null)
{
    <div class="portal-plate mb-4">
        <p class="portal-plate__label">Waiting longest</p>
        <p class="portal-plate__dow">@waiting.Queue</p>
        <p class="portal-plate__date">
            @if (daysWaiting <= 0)
            {
                <text>Today</text>
            }
            else
            {
                @daysWaiting<text> </text>@(daysWaiting == 1 ? "day" : "days")
            }
        </p>
        <p class="portal-plate__hour">@waiting.Who</p>

        <dl class="portal-leaders portal-plate__ledger">
            <div class="portal-lead">
                <dt class="portal-lead__k">About</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@waiting.What</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Received</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@waiting.WaitingSince.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Outstanding across all queues</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@openItems</dd>
            </div>
        </dl>

        <p class="portal-plate__prep">
            This is the oldest request a patient is still waiting on. Deciding it
            first keeps the queue in the order people joined it.
        </p>

        <div class="portal-plate__acts">
            <a asp-area="Admin"
               asp-controller="@waiting.Controller"
               asp-action="@waiting.Action"
               asp-route-id="@waiting.RecordId"
               class="btn btn-primary">Open this request</a>
            <a asp-area="Admin" asp-controller="@waiting.Controller" asp-action="Index" class="btn btn-outline-secondary">See the whole queue</a>
        </div>
    </div>
}
else
{
    <div class="portal-empty mb-4">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">Every queue is clear</p>
        <p class="portal-empty__p">
            No appointment request, teleconsultation or patient message is waiting
            on a member of staff. New ones appear here as they arrive.
        </p>
    </div>
}

<h2 class="visually-hidden">Queues</h2>
<div class="portal-index mb-4">
    @foreach (var queue in queues)
    {
        <a class="portal-index__row" asp-area="Admin" asp-controller="@queue.Controller" asp-action="Index">
            <span class="portal-index__k">
                @queue.Label
                @if (queue.Count > 0)
                {
                    <span class="portal-index__note">&mdash; @queue.Note</span>
                }
            </span>
            <span class="portal-index__v @(queue.Count == 0 ? "portal-index__v--none" : string.Empty)">@queue.Count</span>
        </a>
    }
    <a class="portal-index__row" asp-area="Admin" asp-controller="ContactSubmissions" asp-action="Index">
        <span class="portal-index__k">
            Contact submissions
            <span class="portal-index__note">&mdash; a running inbox, not a queue</span>
        </span>
        <span class="portal-index__v @(Model.ContactSubmissionsCount == 0 ? "portal-index__v--none" : string.Empty)">@Model.ContactSubmissionsCount</span>
    </a>
</div>

<div class="portal-register portal-register--titled mb-4">
    <div class="portal-register__cap">
        <h2 class="portal-register__capt">The hospital on record</h2>
        <p class="portal-register__capn">What the public site is currently showing</p>
    </div>

    <div class="portal-register__row">
        <div class="min-w-0">
            <p class="portal-register__what">Doctors</p>
            <p class="portal-register__meta">Listed on the care team page</p>
        </div>
        <p class="portal-register__sum">@Model.DoctorsCount</p>
        <div class="portal-register__acts">
            <a asp-area="" asp-controller="Doctors" asp-action="Index" class="portal-act">Manage</a>
        </div>
    </div>

    <div class="portal-register__row">
        <div class="min-w-0">
            <p class="portal-register__what">Departments</p>
            <p class="portal-register__meta">Offered when a patient books</p>
        </div>
        <p class="portal-register__sum">@Model.DepartmentsCount</p>
        <div class="portal-register__acts">
            <a asp-area="" asp-controller="Departments" asp-action="Index" class="portal-act">Manage</a>
        </div>
    </div>

    <div class="portal-register__row">
        <div class="min-w-0">
            <p class="portal-register__what">News posts</p>
            <p class="portal-register__meta">Drafts and published notes together</p>
        </div>
        <p class="portal-register__sum">@Model.PostsCount</p>
        <div class="portal-register__acts">
            <a asp-area="Admin" asp-controller="Posts" asp-action="Index" class="portal-act">Manage</a>
        </div>
    </div>

    <div class="portal-register__row">
        <div class="min-w-0">
            <p class="portal-register__what">Appointment requests received</p>
            <p class="portal-register__meta">
                @Model.ApprovedAppointmentsCount approved &middot;
                @Model.PendingAppointmentsCount pending &middot;
                @Model.RejectedAppointmentsCount rejected
            </p>
        </div>
        <p class="portal-register__sum">@Model.AppointmentsCount</p>
        <div class="portal-register__acts">
            <a asp-area="Admin" asp-controller="AppointmentRequests" asp-action="Index" class="portal-act">Review</a>
        </div>
    </div>

    @if (billPaymentsEnabled)
    {
        <div class="portal-register__row">
            <div class="min-w-0">
                <p class="portal-register__what">Confirmed revenue</p>
                <p class="portal-register__meta">@Model.PaidBillPaymentsCount payments settled in naira</p>
            </div>
            <p class="portal-register__sum">NGN @Model.TotalPaidRevenue.ToString("N2")</p>
            <div class="portal-register__acts">
                <a asp-area="Admin" asp-controller="BillPayments" asp-action="Index" class="portal-act">Review</a>
            </div>
        </div>
    }
</div>

<div class="portal-register">
    <div class="portal-register__cap">
        <h2 class="portal-register__capt">The last seven days</h2>
        <p class="portal-register__capn">Everything that arrived, most recent first</p>
    </div>

    @if (Model.RecentActivity.Any())
    {
        @foreach (var item in Model.RecentActivity)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@item.CreatedAt.ToLocalTime().ToString("dd")</span>
                    <span class="portal-register__m">@item.CreatedAt.ToLocalTime().ToString("MMM")</span>
                </p>
                <div class="min-w-0">
                    <p class="portal-register__what">@item.Title</p>
                    <p class="portal-register__meta">@item.Details</p>
                </div>
                <p class="portal-register__meta">@item.Category</p>
                <p class="portal-register__meta">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</p>
            </div>
        }
    }
    else
    {
        <div class="portal-leaf">
            <p class="portal-register__meta mb-0">Nothing has arrived in the last seven days.</p>
        </div>
    }
</div>
