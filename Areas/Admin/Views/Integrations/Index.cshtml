@model Okafor_.NET.ViewModels.IntegrationReadinessViewModel

@{
    ViewData["Title"] = "Integration readiness";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Launch operations</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Integration readiness</h1>
    </div>
    <p class="portal-page-lede">
        Whether the configuration is present for the @Model.EnvironmentName
        environment. Secret values are never shown here.
    </p>
</div>

<div class="portal-notice portal-notice--grave mb-4">
    <p class="portal-notice__k">Configured is not the same as tested</p>
    <p class="portal-notice__b">
        Every live integration still needs a controlled request on staging, and a
        callback or delivery check, before launch.
    </p>
</div>

<div class="portal-index mb-4">
    <div class="portal-index__row">
        <span class="portal-index__k">Configured</span>
        <span class="portal-index__v">@Model.ConfiguredCount / @Model.Integrations.Count</span>
    </div>
    <div class="portal-index__row">
        <span class="portal-index__k">
            Required for launch
            @if (Model.RequiredConfiguredCount < Model.RequiredCount)
            {
                <span class="portal-index__note">&mdash; @(Model.RequiredCount - Model.RequiredConfiguredCount) still to set up</span>
            }
        </span>
        <span class="portal-index__v">@Model.RequiredConfiguredCount / @Model.RequiredCount</span>
    </div>
</div>

<div class="portal-register portal-register--titled portal-register--brief">
    <div class="portal-register__cap">
        <h2 class="portal-register__capt">Register of integrations</h2>
        <p class="portal-register__capn">Required for launch first</p>
    </div>

    @foreach (var integration in Model.Integrations.OrderByDescending(i => i.IsRequiredForLaunch).ThenBy(i => i.Name))
    {
        <div class="portal-register__row">
            <div class="min-w-0">
                <p class="portal-register__what">@integration.Name</p>
                <p class="portal-register__meta">@integration.Purpose</p>
                <p class="portal-register__sub">Activated by @integration.ActivationMode</p>

                @if (integration.MissingKeys.Count > 0)
                {
                    <p class="portal-register__next">
                        Missing:
                        @for (var index = 0; index < integration.MissingKeys.Count; index++)
                        {
                            <code>@integration.MissingKeys[index].Replace(":", "__")</code>
                            @(index < integration.MissingKeys.Count - 1 ? ", " : string.Empty)
                        }
                    </p>
                }

                <p class="portal-register__next">Next check: @integration.SetupHint</p>
            </div>

            <p class="mb-0">
                <span class="portal-mark @(integration.IsConfigured ? "bg-success" : integration.IsRequiredForLaunch ? "bg-warning" : "bg-secondary")">
                    @(integration.IsConfigured ? "Configured" : integration.IsRequiredForLaunch ? "Needs setup" : "Not configured")
                </span>
                @if (integration.IsRequiredForLaunch)
                {
                    <span class="portal-register__sub d-block mt-1">Required for launch</span>
                }
            </p>
        </div>
    }
</div>
