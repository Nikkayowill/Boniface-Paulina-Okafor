@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<section class="account-shell">
    <div class="mx-auto w-full max-w-md px-6">

        <div class="mb-8 text-center">
            <p class="uppercase text-primary-800 mb-1 text-[14px] font-semibold tracking-[0.02em]">Account Recovery</p>
            <h1 class="font-serif text-3xl font-normal text-[#1a1a1a]">Reset Your Password</h1>
            <p class="mt-2 text-sm text-[#5c5c5c]">Enter your email address and we&apos;ll send you a reset link</p>
        </div>

        <div class="account-card">

            <div asp-validation-summary="ModelOnly" class="mb-5 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></div>

            <form method="post" class="space-y-5">

                <div>
                    <label asp-for="Input.Email" class="ok-form-label">Email address</label>
                    <input asp-for="Input.Email" class="ok-field" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-red-600"></span>
                </div>

                <button type="submit" class="site-button site-button--primary w-full">
                    Send Reset Link
                </button>

            </form>

            <div class="mt-6 border-t border-bone-300 pt-5 text-center">
                <a asp-page="./Login" class="text-sm text-primary-800 hover:text-teal-900">Back to sign in</a>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
