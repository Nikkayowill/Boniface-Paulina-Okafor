@using Microsoft.AspNetCore.Identity
@using Okafor_.NET.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures

@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    string ActiveClass(params string[] prefixes) =>
        prefixes.Any(prefix => currentPath.StartsWith(prefix, System.StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patient Portal</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#032720" />
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="icon" href="~/images/icons/bapom-logo.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&family=Roboto+Condensed:wght@900&family=Roboto+Serif:opsz,wght@8..144,400;8..144,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<a class="visually-hidden-focusable btn btn-primary m-2" href="#portal-content">Skip to content</a>

<div class="portal-shell d-flex">
    <aside class="portal-rail offcanvas-lg offcanvas-start" tabindex="-1" id="patientSidebar" aria-labelledby="patientSidebarLabel">
        <div class="offcanvas-header d-lg-none">
            <div>
                <p class="portal-rail__name mb-0" id="patientSidebarLabel">BAPOM Hospital</p>
                <p class="portal-rail__which">Patient Record</p>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#patientSidebar" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body p-3 d-flex flex-column">
            <div class="portal-rail__brand d-none d-lg-block px-2">
                <span class="portal-lockup" aria-hidden="true">
                    <img src="~/images/brand/bapom-mark-white.svg" alt="" class="portal-lockup__mark" width="40" height="40" />
                    <span class="portal-lockup__bapom">BAPOM</span>
                    <span class="portal-lockup__hospital">Hospital</span>
                </span>
                <p class="visually-hidden">BAPOM Hospital</p>
                <p class="portal-rail__which">Patient Record</p>
            </div>

            <nav class="nav flex-column" aria-label="Patient portal">
                <p class="portal-rail__group px-2">Your care</p>
                <a class="nav-link @ActiveClass("/Portal/Dashboard", "/Patient/Dashboard")" asp-area="Patient" asp-controller="Dashboard" asp-action="Index">
                    <span>Home</span>
                </a>
                <a class="nav-link @ActiveClass("/Portal/Appointments", "/Patient/Appointments")" asp-area="Patient" asp-controller="Appointments" asp-action="Index">
                    <span>Appointments</span>
                </a>
                <a class="nav-link @ActiveClass("/Portal/Teleconsultations", "/Patient/Teleconsultations")" asp-area="Patient" asp-controller="Teleconsultations" asp-action="Index">
                    <span>Teleconsultations</span>
                </a>

                <p class="portal-rail__group px-2">Your file</p>
                @if (LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.PatientDocuments))
                {
                    <a class="nav-link @ActiveClass("/Portal/Documents", "/Patient/Documents")" asp-area="Patient" asp-controller="Documents" asp-action="Index">
                        <span>Documents</span>
                    </a>
                }
                <a class="nav-link @ActiveClass("/Portal/Messages", "/Patient/Messages")" asp-area="Patient" asp-controller="Messages" asp-action="Index">
                    <span>Messages</span>
                </a>
                <a class="nav-link @ActiveClass("/Portal/Profile", "/Patient/Profile")" asp-area="Patient" asp-controller="Profile" asp-action="Index">
                    <span>Your details</span>
                </a>

                <div class="portal-rail__hr mt-3"></div>
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <span>Back to the hospital website</span>
                </a>
            </nav>

            <div class="portal-rail__foot mt-auto">
                <p class="portal-rail__who text-truncate mb-2">@User.Identity?.Name</p>
                @if (SignInManager.IsSignedIn(User))
                {
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post"
                          data-portal-logout-form>
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Sign out</button>
                    </form>
                }
            </div>
        </div>
    </aside>

    <div class="portal-main">
        <header class="portal-crown">
            <div class="d-flex align-items-center gap-3 min-w-0">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#patientSidebar" aria-controls="patientSidebar" aria-label="Open patient navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <p class="portal-crown__where text-truncate">@ViewData["Title"]</p>
            </div>
            <p class="portal-crown__who d-none d-sm-block text-truncate">@User.Identity?.Name</p>
        </header>

        <main class="portal-sheet" id="portal-content">
            @if (TempData["Success"] is string success)
            {
                <div class="portal-notice portal-notice--good alert-dismissible fade show mb-4" role="alert">
                    <p class="portal-notice__k">Done</p>
                    <p class="portal-notice__b">@success</p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="portal-notice portal-notice--grave alert-dismissible fade show mb-4" role="alert">
                    <p class="portal-notice__k">That did not work</p>
                    <p class="portal-notice__b">@error</p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<div class="modal fade" id="portalTimeoutModal" tabindex="-1" aria-labelledby="portalTimeoutTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="portalTimeoutTitle">Session ending soon</h2>
            </div>
            <div class="modal-body text-muted">
                For your privacy, the portal will sign you out after a period of inactivity.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-portal-stay-signed-in>Stay signed in</button>
            </div>
        </div>
    </div>
</div>

@* No portal script uses jQuery; Bootstrap 5 and Alpine are both free of it. The
   forms that want unobtrusive validation pull jQuery in with the validation
   partial instead of every portal page carrying it. *@
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/js/offline-state.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/js/encrypted-offline-store.js" asp-append-version="true"></script>
@if (HostEnvironment.IsDevelopment())
{
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/pwa-development-reset.js" asp-append-version="true"></script>
}
else
{
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/pwa-register.js" asp-append-version="true"></script>
}
<script nonce="@(Context.Items["CspNonce"])" src="~/js/portal-security.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/js/booking-realtime.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
