@model Okafor_.NET.Areas.Patient.Controllers.PatientDashboardViewModel
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures
@{
    ViewData["Title"] = "Overview";

    var documentsEnabled = LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.PatientDocuments);
    var visit = Model.NextVisit;

    // The same status vocabulary the register and booking-realtime.js use, so a
    // live update recolours the mark without any special case here.
    string MarkClass(string status) => status switch
    {
        "Confirmed" or "Approved" => "bg-success",
        "Completed"               => "bg-secondary",
        "Cancelled" or "Rejected" => "bg-danger",
        "Rescheduled"             => "bg-info",
        _                         => "bg-warning"
    };

    // A booking request carries no time until staff set one, in which case
    // PortalAppointmentTime.Combine leaves it at midnight. Printing "12:00 AM"
    // would read as a real appointment at midnight, so say what is true instead.
    var hasTime = visit is not null && visit.Date.TimeOfDay != TimeSpan.Zero;
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your record</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.PatientName</h1>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-primary">Request a visit</a>
    </div>
</div>

<div class="alert d-none" data-booking-realtime role="status" aria-live="polite"></div>

@if (!Model.HasProfile)
{
    <div class="portal-plate mb-4">
        <p class="portal-plate__label">Before anything else</p>
        <p class="portal-plate__dow">Your account is not linked to a patient file yet</p>
        <p class="portal-plate__prep">
            Adding your name and telephone number lets the hospital attach your
            appointments, messages and documents to the right record. It takes a minute.
        </p>
        <div class="portal-plate__acts">
            <a asp-area="Patient" asp-controller="Profile" asp-action="Create" class="btn btn-primary">Complete my profile</a>
        </div>
    </div>
}
else if (visit is not null)
{
    var pending = visit.Status is "Pending";

    <div class="portal-plate @(pending ? "portal-plate--quiet" : string.Empty) mb-4">
        <p class="portal-plate__label">@(pending ? "Awaiting a date" : "Your next visit")</p>

        @if (pending)
        {
            <p class="portal-plate__dow">Requested for @visit.Date.ToString("dddd d MMMM")</p>
            <p class="portal-plate__date portal-plate__date--none">&mdash;</p>
            <p class="portal-plate__hour portal-plate__hour--none">Staff will contact you</p>
        }
        else
        {
            <p class="portal-plate__dow">@visit.Date.ToString("dddd")</p>
            <p class="portal-plate__date">@visit.Date.ToString("d MMMM")</p>
            <p class="portal-plate__hour">
                @if (hasTime)
                {
                    @visit.Date.ToString("HH:mm")
                }
                else
                {
                    <text>Time to be confirmed</text>
                }
            </p>
        }

        <dl class="portal-leaders portal-plate__ledger">
            <div class="portal-lead">
                <dt class="portal-lead__k">Department</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@visit.Department</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Attending</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@(visit.Doctor ?? "Not yet assigned")</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Standing</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">
                    <span class="portal-mark @MarkClass(visit.Status)" data-booking-status="appointment:@visit.BookingStatusId">@visit.Status</span>
                </dd>
            </div>
        </dl>

        <p class="portal-plate__prep">
            @if (pending)
            {
                <text>The hospital will telephone you on the number in your profile to confirm this date or offer another.</text>
            }
            else
            {
                <text>Arrive fifteen minutes early. Bring your identification and any referral letters.</text>
            }
        </p>

        <div class="portal-plate__acts">
            <a asp-area="Patient" asp-controller="Appointments" asp-action="Index" class="btn btn-primary">See this appointment</a>
            @if (!pending)
            {
                <a asp-area="Patient"
                   asp-controller="Appointments"
                   asp-action="DownloadCalendar"
                   asp-route-sourceType="@visit.SourceType"
                   asp-route-sourceId="@visit.SourceId"
                   class="btn btn-outline-secondary">Add to calendar</a>
            }
        </div>
    </div>
}
else
{
    <div class="portal-empty mb-4">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">Nothing is scheduled</p>
        <p class="portal-empty__p">
            When the hospital books you a visit it will appear here with the date, the
            department and the doctor you are seeing.
        </p>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-primary">Request a visit</a>
    </div>
}

<h2 class="visually-hidden">The rest of your record</h2>
<div class="portal-index">
    <a class="portal-index__row" asp-area="Patient" asp-controller="Appointments" asp-action="Index">
        <span class="portal-index__k">
            Appointments
            @if (Model.PendingBookingRequestsCount > 0)
            {
                <span class="portal-index__note">&mdash; @Model.PendingBookingRequestsCount awaiting a date</span>
            }
        </span>
        <span class="portal-index__v @(Model.UpcomingAppointmentsCount == 0 ? "portal-index__v--none" : string.Empty)">@Model.UpcomingAppointmentsCount</span>
    </a>

    <a class="portal-index__row" asp-area="Patient" asp-controller="Teleconsultations" asp-action="Index">
        <span class="portal-index__k">Teleconsultations</span>
        <span class="portal-index__v @(Model.PendingTeleconsultationsCount == 0 ? "portal-index__v--none" : string.Empty)">@Model.PendingTeleconsultationsCount</span>
    </a>

    <a class="portal-index__row" asp-area="Patient" asp-controller="Messages" asp-action="Index">
        <span class="portal-index__k">
            Messages
            @if (Model.MessagesAwaitingReviewCount > 0)
            {
                <span class="portal-index__note">&mdash; awaiting staff review</span>
            }
        </span>
        <span class="portal-index__v @(Model.MessagesAwaitingReviewCount == 0 ? "portal-index__v--none" : string.Empty)">@Model.MessagesAwaitingReviewCount</span>
    </a>

    @if (documentsEnabled)
    {
        <a class="portal-index__row" asp-area="Patient" asp-controller="Documents" asp-action="Index">
            <span class="portal-index__k">Documents</span>
            <span class="portal-index__v @(Model.PendingDocumentsCount == 0 ? "portal-index__v--none" : string.Empty)">@Model.PendingDocumentsCount</span>
        </a>
    }

    <a class="portal-index__row" asp-area="Patient" asp-controller="Profile" asp-action="Index">
        <span class="portal-index__k">Your details</span>
        <span class="portal-index__v" aria-hidden="true">&rsaquo;</span>
    </a>
</div>

<div class="mt-4">
    @await Component.InvokeAsync("PushNotifications")
</div>

@section Scripts {
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/push-notifications.js" asp-append-version="true"></script>
}
