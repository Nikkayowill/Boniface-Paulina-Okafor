# Copy to .env, replace both matching password values, then run docker compose.
# URL-encode special characters in DATABASE_URL's password.
POSTGRES_DB=okafor_hospital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_LOCAL_PASSWORD@localhost:5432/okafor_hospital?sslmode=Disable

# Brevo SMTP email. Keep real values in your local .env or deployment secrets.
Email__SmtpHost=smtp-relay.brevo.com
Email__Port=587
Email__EnableSsl=true
Email__FromAddress=info@okaformemorial.org
Email__Username=REPLACE_WITH_BREVO_SMTP_LOGIN
Email__Password=REPLACE_WITH_BREVO_SMTP_KEY

# Optional Sentry error tracking. Leave blank to keep Sentry disabled locally.
SENTRY_DSN=
